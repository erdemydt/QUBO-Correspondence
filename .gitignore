# Build output. Glob rather than a single name so scratch build trees
# (build-debug/, build2/, ...) are covered too.
build*/
out/

# CMake artifacts
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
_deps/
tests/
# Mesh datasets. These are large (SCAPE ~54 MB, TOSCA ~171 MB) and are treated
# as external inputs, not source. Add a line here when adding a new dataset
# directory, and register it in include/fmap/dataset.hpp.
scape-bim/
tosca-offs/

# Editor / OS
.vscode/
.idea/
.cache/
*.swp
.DS_Store
